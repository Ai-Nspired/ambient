{
  "name": "ambient",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "services": [
    // The dock is ARA's extension, so her pass runs here before anything is
    // generated — over a binding, because a workers.dev Worker may not fetch
    // another workers.dev hostname (Cloudflare 1042).
    { "binding": "ARA", "service": "ara" },
    // TRNV, bound so this Worker can reach it over a service binding.
    { "binding": "TRNV", "service": "trnv" },
    // The neighbours that remain.
    { "binding": "CODS", "service": "cods" },
    { "binding": "TEW", "service": "tew" }
  ],
  "kv_namespaces": [
    // His preferences and intentions: read before every answer, written when he
    // states a new one. This is Memoria, the same store the account curates.
    { "binding": "PREFS", "id": "4a9bfbffb4d440cba86badc508e2045a" }
  ],
  "vars": {
    // No model route is declared: ARA answers, and when she does not, the dock
    // says so instead of reaching for another voice.
    "ACCENT": "#4a9eff"
  }
}
