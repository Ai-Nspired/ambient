{
  "name": "ambient",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "services": [
    // The dock is ARA's extension, so her pass runs here before anything is
    // generated — over a binding, because a workers.dev Worker may not fetch
    // another workers.dev hostname (Cloudflare 1042).
    { "binding": "ARA", "service": "ara" },
    // TRNV, bound so this Worker can reach it over a service binding.
    { "binding": "TRNV", "service": "trnv" },
    // The neighbours that remain.
    { "binding": "CODS", "service": "cods" },
    { "binding": "TEW", "service": "tew" },
    // The vision model lives behind ai-proxy, whose key is already bound there.
    // Reached over a binding for the same 1042 reason as above.
    { "binding": "AI_PROXY", "service": "ai-proxy" },
    // Bound in the dashboard on 2026-11-26; mirrored here so a build from this
    // repository cannot drop it.
    { "binding": "AI-PROXY", "service": "ai-proxy" },
    { "binding": "CFMAIL", "service": "ai-n-email" }
  ],
  "kv_namespaces": [
    // His preferences and intentions: read before every answer, written when he
    // states a new one. This is Memoria, the same store the account curates.
    { "binding": "PREFS", "id": "4a9bfbffb4d440cba86badc508e2045a" }
  ],
  "vars": {
    // The account this Worker belongs to: the browser-rendering route is built
    // from it, so no URL is assembled by guesswork.
    "CF_ACCOUNT": "771ee2cc20f09248129114b7535b2cc9",
    // The model the pen writes with until he picks one in the dock. ARA still
    // decides; this is only the voice that repeats what she decided. Chosen by
    // price: nothing above nine cents a million tokens runs.
    "MODEL": "upstage/solar-mini-4-5",
    "VISION_MODEL": "google/gemma-3-4b-it",
    // Which pages may read or write his memory besides this Worker's own origin.
    // The card surface is the one that does: both names it answers to, because a
    // browser sends whichever one the operator is on. Anything else is named here
    // deliberately, never wildcarded.
    "PREFS_ORIGINS": "https://cods.nspired.cc,https://cods.ai-n.workers.dev",
    "ACCENT": "#4a9eff"
  },
  // The store the cards page reads before it asks her. Bound the way the cards
  // Worker binds it, because that shape is known to work here — a services entry
  // is checked against the account at deploy time and a binding to a Worker that
  // is not there fails the whole deploy. Read-only on this side: nothing is
  // written through it.
  "unsafe": {
    "bindings": [
      // The account's own agent browser, bound by the name his config gives it.
      // Nothing here calls it yet: it answers as a devtools endpoint
      // (/json/version, /v1/devtools/browser), not as a page-to-text route.
      {
        "name": "ABROWSER",
        "type": "service",
        "service": "agent-browsing",
        "environment": "production",
        "entrypoint": "default"
      },
      {
        "name": "TRUTH",
        "type": "service",
        "service": "truth",
        "environment": "production",
        "entrypoint": "default"
      }
    ]
  },
  // Dynamic Workers: code loaded at runtime into its own sandbox, for work that
  // should not run inside this Worker's own isolate.
  "worker_loaders": [
    { "binding": "LOADER" }
  ]
}
