{
  "name": "ambient",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // Every neighbour is bound here in the shape the deployed Worker actually holds:
  // `unsafe` service bindings with their environment named, because that is what the
  // account has and a `services` entry is checked differently at deploy time. A
  // workers.dev Worker may not fetch another workers.dev hostname (Cloudflare 1042),
  // so each of these is reached over its binding and never over the open internet.
  "unsafe": {
    "bindings": [
      // The account's own agent browser. Nothing here calls it yet: it answers as a
      // devtools endpoint (/json/version, /v1/devtools/browser), not as a page route.
      {
        "name": "ABROWSER",
        "type": "service",
        "service": "agent-browsing",
        "environment": "production",
        "entrypoint": "default"
      },
      // The proxy that holds the upstream model key: the pen writes a picture turn
      // through it, and /api/decisions spends a Decisions call through it. One
      // binding, under the dashed name; the code reads either spelling so a rename
      // on one side cannot quietly unbind the answers.
      {
        "name": "AI-PROXY",
        "type": "service",
        "service": "ai-proxy",
        "environment": "production"
      },
      // The dock is ARA's extension, so her pass runs before anything is generated.
      {
        "name": "ARA",
        "type": "service",
        "service": "ara",
        "environment": "production"
      },
      // Mail, bound so a build from this repository cannot drop it.
      {
        "name": "CFMAIL",
        "type": "service",
        "service": "ai-n-email",
        "environment": "production"
      },
      // The card store: the pen writes through it and the dock reads a stored pair.
      {
        "name": "CODS",
        "type": "service",
        "service": "cods",
        "environment": "production"
      },
      {
        "name": "TEW",
        "type": "service",
        "service": "tew",
        "environment": "production"
      },
      {
        "name": "TRNV",
        "type": "service",
        "service": "trnv",
        "environment": "production"
      },
      {
        "name": "TRUTH",
        "type": "service",
        "service": "truth",
        "environment": "production",
        "entrypoint": "default"
      }
    ]
  },
  "kv_namespaces": [
    // His preferences and intentions: read before every answer, written when he
    // states a new one. This is Memoria, the same store the account curates.
    { "binding": "PREFS", "id": "4a9bfbffb4d440cba86badc508e2045a" }
  ],
  "vars": {
    // The account this Worker belongs to: the browser-rendering route is built
    // from it, so no URL is assembled by guesswork.
    "CF_ACCOUNT": "771ee2cc20f09248129114b7535b2cc9",
    // The model the pen writes with until he picks one in the dock. ARA still
    // decides; this is only the voice that repeats what she decided. Chosen by
    // price: nothing above nine cents a million tokens runs.
    "MODEL": "upstage/solar-mini-4-5",
    "VISION_MODEL": "google/gemma-3-4b-it",
    // Which pages may read or write his memory besides this Worker's own origin.
    // The card surface is the one that does: both names it answers to, because a
    // browser sends whichever one the operator is on. Anything else is named here
    // deliberately, never wildcarded.
    "PREFS_ORIGINS": "https://cods.nspired.cc,https://cods.ai-n.workers.dev",
    "ACCENT": "#4a9eff"
  },
  // Dynamic Workers: code loaded at runtime into its own sandbox, for work that
  // should not run inside this Worker's own isolate.
  "worker_loaders": [
    { "binding": "LOADER" }
  ]
}
